{
  "name": "stateless-agents",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": {"cpus": 4, "memory": "8gb"},
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {"dockerDashComposeVersion": "none"}
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "echo 'Ready. Run: make board (in one terminal), then make act1 (in another).'"
}
